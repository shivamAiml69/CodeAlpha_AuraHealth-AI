{
  "framework": "PyTorch 2.15.0+cpu",
  "model_architecture": "BreastCancerCNN",
  "input_shape": [3, 50, 50],
  "normalization": {
    "mean": [0.485, 0.456, 0.406],
    "std": [0.229, 0.224, 0.225]
  },
  "classes": [
    "IDC Negative",
    "IDC Positive"
  ],
  "class_to_idx": {
    "IDC Negative": 0,
    "IDC Positive": 1
  },
  "positive_class": "IDC Positive",
  "negative_class": "IDC Negative",
  "task": "Invasive Ductal Carcinoma (IDC) Histopathology Detection",
  "decision_threshold": 0.5,
  "is_smoke_test": false,
  "training_mode": "real_dataset",
  "source_script": "train_cnn.py",
  "training_parameters": {
    "epochs": 5,
    "batch_size": 64,
    "image_size": [50, 50],
    "samples_trained": 4000,
    "class_distribution": {
      "Benign (IDC Negative)": 2000,
      "Malignant (IDC Positive)": 2000
    },
    "split": "80% Train, 20% Validation",
    "optimizer": "Adam (lr=0.001)",
    "loss": "CrossEntropyLoss"
  }
}
